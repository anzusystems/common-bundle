#!/bin/bash

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
CHECK_DIR=${1:-}

cd "${PROJECT_ROOT}" || exit 1

if [ -f /.dockerenv ]; then
    echo "[INFO] Running PHPStan check"
    vendor/bin/phpstan analyse --memory-limit=1G ${CHECK_DIR}
    exit
fi

bin/docker-compose run --rm app bash -c \'bin/phpstan "${CHECK_DIR}"\'
