parametersSchema:
    anzuMcpObjectArray: structure([
        classNamespaces: listOf(string()),
        objectNamespace: string(),
    ])
    anzuNamedArguments: structure([
        classNamespaces: listOf(string()),
    ])
    anzuMcpToolInputPermission: structure([
        inputPermissions: arrayOf(string(), string()),
    ])

parameters:
    anzuMcpObjectArray:
        classNamespaces: []
        objectNamespace: ''
    anzuNamedArguments:
        classNamespaces: []
    anzuMcpToolInputPermission:
        inputPermissions: []

services:
    -
        class: AnzuSystems\CommonBundle\PHPStan\Rules\McpObjectArrayRule
        arguments:
            classNamespaces: %anzuMcpObjectArray.classNamespaces%
            objectNamespace: %anzuMcpObjectArray.objectNamespace%
        tags:
            - phpstan.rules.rule
    -
        class: AnzuSystems\CommonBundle\PHPStan\Rules\NamedArgumentsRule
        arguments:
            classNamespaces: %anzuNamedArguments.classNamespaces%
        tags:
            - phpstan.rules.rule
    -
        class: AnzuSystems\CommonBundle\PHPStan\Rules\McpToolInputPermissionRule
        arguments:
            inputPermissions: %anzuMcpToolInputPermission.inputPermissions%
        tags:
            - phpstan.rules.rule
